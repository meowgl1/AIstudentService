# Backend database (Render Postgres in deployment)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set false only when using a local Postgres instance without TLS.
DATABASE_SSL=true

# Student ticket anti-abuse controls
TICKET_RATE_LIMIT=5

# RAG retrieval (Thomas/Santiago components)
VOYAGE_API_KEY=
RAG_COSINE_FLOOR=0.5

# Future LLM pipeline integration
OPENROUTER_API_KEY=
